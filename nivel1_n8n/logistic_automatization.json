    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst chatId = $('Entrada Mensaje').first().json.message.chat.id;\n\nconst pedidosValidos = rows\n  .map(item => item.json)\n  .filter(pedido => pedido.estado !== 'SIN_STOCK');\n\nif (!pedidosValidos.length) {\n  return [\n    {\n      json: {\n        chat_id: chatId,\n        mensaje: 'No encontré pedidos válidos para consultar el estado. Los pedidos con estado SIN_STOCK no se tienen en cuenta.'\n      }\n    }\n  ];\n}\n\nconst ultimo = pedidosValidos[pedidosValidos.length - 1];\n\nconst mensaje = `Pedido ${ultimo.order_id}\nProducto: ${ultimo.descripcion_producto || ultimo.producto_id}\nCantidad: ${ultimo.cantidad}\nEstado: ${ultimo.estado}\nTotal: ${ultimo.total || 0}\nFecha pedido: ${ultimo.fecha_pedido || 'No registrada'}\nFecha despacho: ${ultimo.fecha_despacho || 'Pendiente'}`;\n\nreturn [\n  {\n    json: {\n      chat_id: ultimo.chat_id || chatId,\n      mensaje\n    }\n  }\n];"
      },
