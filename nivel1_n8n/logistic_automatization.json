      "parameters": {
        "jsCode": "const stockRow = $input.first().json;\nconst pedido = $('Variables utiles a JSON').first().json;\nconst telegram = $('Entrada Mensaje').first().json;\n\nconst cantidad = Number(pedido.cantidad || 0);\nconst stock = Number(stockRow.stock_anual || stockRow.stock || 0);\nconst precio_unitario = Number(stockRow.precio_unitario || 0);\nconst total = cantidad * precio_unitario;\n\nreturn [\n  {\n    json: {\n      order_id: pedido.order_id,\n      producto_id: pedido.producto_id,\n      cantidad,\n      cliente: telegram.message.from.first_name,\n      chat_id: telegram.message.chat.id,\n      descripcion_producto: stockRow.descripcion_producto,\n      stock,\n      precio_unitario,\n      total,\n      fecha_pedido: new Date(telegram.message.date * 1000).toLocaleString('sv-SE', {\n        timeZone: 'America/Bogota'\n      }).replace(' ', ' '),\n      fecha_despacho: new Date().toLocaleString('sv-SE', {\n        timeZone: 'America/Bogota'\n      }).replace(' ', ' ')\n    }\n  }\n];"
      },
